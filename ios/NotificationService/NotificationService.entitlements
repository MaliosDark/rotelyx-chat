<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same two, and nothing else. An extension gets the narrowest set of
	     entitlements that lets it do its job: it reads the conversation log and
	     the key that opens it, and it has no business with the network, the
	     camera, or anything else this application can reach. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.ideoalabs.rotelyx</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.ideoalabs.rotelyx</string>
	</array>
</dict>
</plist>
