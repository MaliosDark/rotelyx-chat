<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container the application and its notification extension share.
	     Two processes, one encrypted conversation log, because a push arrives
	     in the extension's process and the message it is about is in the
	     application's. See docs/PUSH.md. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rotelyx.ios</string>
	</array>

	<!-- The keychain the two share, which holds one item: the key that opens
	     the conversation log. Its accessibility is set in code, not here, and
	     it is `AfterFirstUnlock`: the extension has to work on a locked screen
	     and cannot ask anybody for a passphrase. What that costs is written
	     down in docs/PUSH.md rather than left for somebody to discover. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.rotelyx.ios</string>
	</array>

	<!-- Production. A development build wants `development` here and its tokens
	     are then valid only against Apple's sandbox. Getting the two out of
	     step yields `BadDeviceToken` and no other clue. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- So an invitation link opens this application rather than Safari.
	     Android has done this since the beginning through an intent filter;
	     iOS asks for the domain to be named here and for the site to serve
	     `/.well-known/apple-app-site-association` naming this app back.

	     The invitation is in the fragment of the link and a fragment never
	     reaches a server, so what the site is asked for is `/i` and nothing
	     else. Association does not change that: it makes the request stop
	     happening at all, because the phone opens the app instead.

	     `applinks:` and not `webcredentials:`: this is about opening links and
	     not about sharing passwords, and there are none to share. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rotelyx.com</string>
	</array>
</dict>
</plist>
